# Reflow - Environment Configuration
# "Create once. Transform everywhere."

# Server
PORT=3000
API_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./storage/reflow.db
REDIS_URL=redis://localhost:6379/0

# Storage Provider (local | s3 | r2)
STORAGE_PROVIDER=local
STORAGE_DIR=./storage
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# AI Provider API Keys (Bring Your Own Key)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Platform OAuth Application Credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

META_CLIENT_ID=
META_CLIENT_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=
