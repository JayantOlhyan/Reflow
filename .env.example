# ==============================================================================
# Reflow — Configuration Environment Template
# "Create once. Transform everywhere."
# ==============================================================================

# Server Environment
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database Configuration
# Local SQLite: sqlite+aiosqlite:///./storage/reflow.db
# PostgreSQL: postgresql+asyncpg://reflow:reflow@localhost:5432/reflow
DATABASE_URL=sqlite+aiosqlite:///./storage/reflow.db

# Storage Provider (local | s3 | r2)
STORAGE_PROVIDER=local
STORAGE_DIR=./storage
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Redis Job Queue (Optional in Phase 0)
REDIS_URL=redis://localhost:6379/0

# AI Provider Keys (Bring Your Own Key - Optional for offline mock)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Security & Token Encryption
ENCRYPTION_SECRET=reflow_dev_secret_key_change_in_production_32b

# Platform OAuth Application Credentials (Self-Hosted Admin)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/connections/youtube/callback

META_CLIENT_ID=
META_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/connections/instagram/callback
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/connections/facebook/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/connections/linkedin/callback

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/api/connections/x/callback

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/connections/tiktok/callback

PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:8000/api/connections/pinterest/callback

THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:8000/api/connections/threads/callback
