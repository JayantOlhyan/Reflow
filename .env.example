# ==============================================================================
# Reflow — Self-Hosted Environment Variable Specification
# "Create once. Transform everywhere."
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Name: APP_NAME
# Purpose: Name of the Reflow application instance
# Example: Reflow API
# Status: Optional
APP_NAME=Reflow API

# Name: APP_VERSION
# Purpose: Single source of truth application release version
# Example: 1.0.0
# Status: Optional
APP_VERSION=1.0.0

# Name: ENVIRONMENT
# Purpose: Application environment mode (development | production | test)
# Example: production
# Status: Required
ENVIRONMENT=development

# Name: DEPLOYMENT_MODE
# Purpose: Security and ownership mode (single_user | multi_user)
# Example: single_user
# Status: Required
DEPLOYMENT_MODE=single_user

# Name: DEBUG
# Purpose: Enable verbose debug logs and SQL query echo
# Example: false
# Status: Optional
DEBUG=false

# Name: HOST
# Purpose: Network interface host IP binding for API server
# Example: 0.0.0.0
# Status: Optional
HOST=0.0.0.0

# Name: PORT
# Purpose: HTTP port for API server
# Example: 8000
# Status: Optional
PORT=8000

# Name: NEXT_PUBLIC_API_URL
# Purpose: Frontend base URL for backend REST API calls
# Example: http://localhost:8000
# Status: Required
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Name: DATABASE_URL
# Purpose: Database connection string (PostgreSQL or SQLite with async driver)
# Example: postgresql+asyncpg://reflow:reflow_password@postgres:5432/reflow
# Status: Required
DATABASE_URL=postgresql+asyncpg://reflow:reflow_password@postgres:5432/reflow

# ------------------------------------------------------------------------------
# 3. REDIS CONFIGURATION
# ------------------------------------------------------------------------------
# Name: REDIS_URL
# Purpose: Connection string for Redis job queue & rate-limiting store
# Example: redis://redis:6379/0
# Status: Required
REDIS_URL=redis://redis:6379/0

# Name: REDIS_MEDIA_QUEUE
# Purpose: Redis list queue key name for asynchronous media background jobs
# Example: reflow:media_jobs
# Status: Optional
REDIS_MEDIA_QUEUE=reflow:media_jobs

# ------------------------------------------------------------------------------
# 4. STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Name: STORAGE_PROVIDER
# Purpose: Media storage provider type (local | s3 | r2)
# Example: local
# Status: Required
STORAGE_PROVIDER=local

# Name: STORAGE_DIR
# Purpose: Base local directory path for storing uploads, clips, and exports
# Example: /app/storage
# Status: Required (if STORAGE_PROVIDER=local)
STORAGE_DIR=/app/storage

# Name: MAX_UPLOAD_SIZE_MB
# Purpose: Maximum allowed file upload size in Megabytes
# Example: 500
# Status: Optional
MAX_UPLOAD_SIZE_MB=500

# Name: STORAGE_WARNING_THRESHOLD_PERCENT
# Purpose: Disk usage percentage threshold for triggering system storage warnings
# Example: 85
# Status: Optional
STORAGE_WARNING_THRESHOLD_PERCENT=85

# Name: STORAGE_BUCKET
# Purpose: S3/R2 cloud storage bucket name (future expansion)
# Example: my-reflow-bucket
# Status: Optional
STORAGE_BUCKET=

# Name: STORAGE_ACCESS_KEY
# Purpose: S3/R2 access key ID
# Example: AKIAIOSFODNN7EXAMPLE
# Status: Optional
STORAGE_ACCESS_KEY=

# Name: STORAGE_SECRET_KEY
# Purpose: S3/R2 secret access key
# Example: wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# Status: Optional
STORAGE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 5. AI PROVIDER CONFIGURATION (BRING YOUR OWN KEY)
# ------------------------------------------------------------------------------
# Name: GEMINI_API_KEY
# Purpose: Google Gemini API key for copy generation, clipping, and slide planning
# Example: AIzaSyD...
# Status: Optional (Required for Gemini AI capabilities)
GEMINI_API_KEY=

# Name: OPENAI_API_KEY
# Purpose: OpenAI API key for copy generation and transcript analysis
# Example: sk-proj-...
# Status: Optional (Required for OpenAI capabilities)
OPENAI_API_KEY=

# Name: ANTHROPIC_API_KEY
# Purpose: Anthropic Claude API key for content synthesis
# Example: sk-ant-...
# Status: Optional
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 6. PLATFORM OAUTH CONFIGURATION
# ------------------------------------------------------------------------------
# Name: YOUTUBE_CLIENT_ID
# Purpose: Google / YouTube Data API Client ID
# Example: 123456789-abc.apps.googleusercontent.com
# Status: Optional
YOUTUBE_CLIENT_ID=

# Name: YOUTUBE_CLIENT_SECRET
# Purpose: Google / YouTube Data API Client Secret
# Example: GOCSPX-...
# Status: Optional
YOUTUBE_CLIENT_SECRET=

# Name: YOUTUBE_REDIRECT_URI
# Purpose: Google / YouTube OAuth 2.0 callback redirect URL
# Example: http://localhost:8000/api/connections/youtube/callback
# Status: Optional
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/connections/youtube/callback

# Name: META_CLIENT_ID
# Purpose: Meta App ID for Instagram & Facebook Pages
# Example: 9876543210
# Status: Optional
META_CLIENT_ID=

# Name: META_CLIENT_SECRET
# Purpose: Meta App Secret for Instagram & Facebook Pages
# Example: 0123456789abcdef0123456789abcdef
# Status: Optional
META_CLIENT_SECRET=

# Name: INSTAGRAM_REDIRECT_URI
# Purpose: Instagram Graph API OAuth callback redirect URL
# Example: http://localhost:8000/api/connections/instagram/callback
# Status: Optional
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/connections/instagram/callback

# Name: FACEBOOK_REDIRECT_URI
# Purpose: Facebook Pages API OAuth callback redirect URL
# Example: http://localhost:8000/api/connections/facebook/callback
# Status: Optional
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/connections/facebook/callback

# Name: LINKEDIN_CLIENT_ID
# Purpose: LinkedIn OAuth App Client ID
# Example: 78abcdef123456
# Status: Optional
LINKEDIN_CLIENT_ID=

# Name: LINKEDIN_CLIENT_SECRET
# Purpose: LinkedIn OAuth App Client Secret
# Example: secret_key_here
# Status: Optional
LINKEDIN_CLIENT_SECRET=

# Name: LINKEDIN_REDIRECT_URI
# Purpose: LinkedIn OAuth callback redirect URL
# Example: http://localhost:8000/api/connections/linkedin/callback
# Status: Optional
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/connections/linkedin/callback

# Name: X_CLIENT_ID
# Purpose: X (Twitter) Developer Client ID
# Example: X_CLIENT_ID_HERE
# Status: Optional
X_CLIENT_ID=

# Name: X_CLIENT_SECRET
# Purpose: X (Twitter) Developer Client Secret
# Example: X_CLIENT_SECRET_HERE
# Status: Optional
X_CLIENT_SECRET=

# Name: X_REDIRECT_URI
# Purpose: X (Twitter) OAuth 2.0 callback redirect URL
# Example: http://localhost:8000/api/connections/x/callback
# Status: Optional
X_REDIRECT_URI=http://localhost:8000/api/connections/x/callback

# Name: TIKTOK_CLIENT_KEY
# Purpose: TikTok Developer App Key
# Example: TIKTOK_APP_KEY
# Status: Optional
TIKTOK_CLIENT_KEY=

# Name: TIKTOK_CLIENT_SECRET
# Purpose: TikTok Developer App Secret
# Example: TIKTOK_APP_SECRET
# Status: Optional
TIKTOK_CLIENT_SECRET=

# Name: TIKTOK_REDIRECT_URI
# Purpose: TikTok OAuth callback redirect URL
# Example: http://localhost:8000/api/connections/tiktok/callback
# Status: Optional
TIKTOK_REDIRECT_URI=http://localhost:8000/api/connections/tiktok/callback

# Name: PINTEREST_APP_ID
# Purpose: Pinterest App ID
# Example: PINTEREST_APP_ID
# Status: Optional
PINTEREST_APP_ID=

# Name: PINTEREST_APP_SECRET
# Purpose: Pinterest App Secret
# Example: PINTEREST_APP_SECRET
# Status: Optional
PINTEREST_APP_SECRET=

# Name: PINTEREST_REDIRECT_URI
# Purpose: Pinterest OAuth callback redirect URL
# Example: http://localhost:8000/api/connections/pinterest/callback
# Status: Optional
PINTEREST_REDIRECT_URI=http://localhost:8000/api/connections/pinterest/callback

# Name: THREADS_APP_ID
# Purpose: Threads App ID
# Example: THREADS_APP_ID
# Status: Optional
THREADS_APP_ID=

# Name: THREADS_APP_SECRET
# Purpose: Threads App Secret
# Example: THREADS_APP_SECRET
# Status: Optional
THREADS_APP_SECRET=

# Name: THREADS_REDIRECT_URI
# Purpose: Threads OAuth callback redirect URL
# Example: http://localhost:8000/api/connections/threads/callback
# Status: Optional
THREADS_REDIRECT_URI=http://localhost:8000/api/connections/threads/callback

# ------------------------------------------------------------------------------
# 7. SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# Name: ENCRYPTION_SECRET
# Purpose: 32-character minimum secret key for encrypting OAuth tokens at rest (AES-256 Fernet)
# Example: reflow_dev_secret_key_change_in_production_32b
# Status: Required (MUST change in production)
ENCRYPTION_SECRET=reflow_dev_secret_key_change_in_production_32b

# Name: CORS_ORIGINS
# Purpose: Allowed origins for Cross-Origin Resource Sharing (JSON array or comma-separated list)
# Example: ["http://localhost:3000","http://127.0.0.1:3000"]
# Status: Required
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Name: RATE_LIMIT_PER_MINUTE
# Purpose: Rate limit in requests per minute per IP for sensitive endpoints
# Example: 60
# Status: Optional
RATE_LIMIT_PER_MINUTE=60

# ------------------------------------------------------------------------------
# 8. OBSERVABILITY & LOGGING CONFIGURATION
# ------------------------------------------------------------------------------
# Name: LOG_LEVEL
# Purpose: Logging output level (DEBUG | INFO | WARNING | ERROR)
# Example: INFO
# Status: Optional
LOG_LEVEL=INFO

# Name: METRICS_ENABLED
# Purpose: Flag to enable system and job performance telemetry endpoints
# Example: true
# Status: Optional
METRICS_ENABLED=true
